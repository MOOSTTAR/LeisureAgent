# ============================================================
# LeisureAgent 环境变量配置
# 复制此文件为 backend/python/.env 并填入你的实际值
#   cp .env.example backend/python/.env
# ============================================================

# --- LLM Provider（选择你要用的一个） ---
LLM_PROVIDER=deepseek
# 可选值: deepseek | openai | anthropic | ollama | openai_compatible

# --- DeepSeek（默认） ---
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- OpenAI ---
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama（本地运行，无需 API key） ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- OpenAI 兼容接口 ---
# COMPATIBLE_API_KEY=your-key-here
# COMPATIBLE_BASE_URL=https://your-api-endpoint
# COMPATIBLE_MODEL=your-model-name

# --- LLM 参数（可选） ---
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT=60

# --- 功能开关（可选，默认 true） ---
# USE_LLM_FOR_INTENT=true
# USE_LLM_FOR_PLAN=true

# --- 前端（可选，仅本地开发时需要） ---
# VITE_API_BASE_URL=http://localhost:8000
